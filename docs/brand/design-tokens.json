    "typography": {
      "font-family": {
        "body":    { "$value": "'Plus Jakarta Sans', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif", "$type": "fontFamily" },
        "display": { "$value": "'Space Grotesk', 'Plus Jakarta Sans', system-ui, sans-serif", "$type": "fontFamily" },
        "mono":    { "$value": "'JetBrains Mono', 'Fira Code', 'SF Mono', monospace", "$type": "fontFamily" }
