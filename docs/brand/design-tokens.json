      "scale": {
        "display":  { "$value": { "fontSize": "clamp(2.5rem, 5vw, 4rem)", "fontWeight": 700, "lineHeight": 1.08, "letterSpacing": "-0.025em", "fontFamily": "{kulli.typography.font-family.display}" }, "$type": "typography" },
        "h1":       { "$value": { "fontSize": "2rem", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.02em", "fontFamily": "{kulli.typography.font-family.display}" }, "$type": "typography" },
        "h2":       { "$value": { "fontSize": "1.5rem", "fontWeight": 600, "lineHeight": 1.25, "letterSpacing": "-0.015em", "fontFamily": "{kulli.typography.font-family.display}" }, "$type": "typography" },
        "h3":       { "$value": { "fontSize": "1.25rem", "fontWeight": 700, "lineHeight": 1.3, "letterSpacing": "-0.01em", "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "h4":       { "$value": { "fontSize": "1.0625rem", "fontWeight": 700, "lineHeight": 1.35, "letterSpacing": "-0.005em", "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "body-lg":  { "$value": { "fontSize": "1.125rem", "fontWeight": 400, "lineHeight": 1.6, "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "body":     { "$value": { "fontSize": "1rem", "fontWeight": 400, "lineHeight": 1.5, "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "body-sm":  { "$value": { "fontSize": "0.875rem", "fontWeight": 400, "lineHeight": 1.45, "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "label":    { "$value": { "fontSize": "0.875rem", "fontWeight": 600, "lineHeight": 1, "letterSpacing": "0.01em", "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "caption":  { "$value": { "fontSize": "0.75rem", "fontWeight": 500, "lineHeight": 1.35, "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "overline": { "$value": { "fontSize": "0.6875rem", "fontWeight": 800, "lineHeight": 1, "letterSpacing": "0.1em", "textTransform": "uppercase", "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" }
      }
