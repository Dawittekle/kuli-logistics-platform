{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "kulli": {
    "color": {
      "brand": {
        "primary":      { "$value": "#1F3B87", "$type": "color", "$description": "Primary Royal Navy Blue — core brand identity, headers, main icons" },
        "navy-dark":    { "$value": "#142553", "$type": "color", "$description": "Midnight Navy — primary button background, dark text, footer backgrounds" },
        "navy-light":   { "$value": "#2A4EA2", "$type": "color", "$description": "Medium royal navy blue for secondary elements" },
        "orange":       { "$value": "#FFAD61", "$type": "color", "$description": "Warm Amber Orange — 'K' lettermark accent, hover states, highlights" },
        "orange-hover": { "$value": "#FFA24B", "$type": "color", "$description": "Warm Amber Orange hover state" },
        "orange-subtle":{ "$value": "#FFF3E8", "$type": "color", "$description": "Subtle warm orange tint background" },
        "sky-blue":     { "$value": "#77ACF1", "$type": "color", "$description": "Sky Blue — delivery truck cargo box fill" },
        "powder-blue":  { "$value": "#B0E0E6", "$type": "color", "$description": "Powder Blue — subtle accent badges and highlights" }
      },
      "neutral": {
        "900": { "$value": "#191818", "$type": "color", "$description": "Charcoal / text primary" },
        "800": { "$value": "#2D3748", "$type": "color", "$description": "Text dark secondary" },
        "700": { "$value": "#4A5568", "$type": "color", "$description": "Text body dark" },
        "600": { "$value": "#718096", "$type": "color", "$description": "Text muted strong" },
        "500": { "$value": "#A0AEC0", "$type": "color", "$description": "Text muted" },
        "400": { "$value": "#CBD5E0", "$type": "color", "$description": "Placeholder text" },
        "300": { "$value": "#E2E8F0", "$type": "color", "$description": "Borders strong" },
        "200": { "$value": "#EDF2F7", "$type": "color", "$description": "Borders light" },
        "100": { "$value": "#F7FAFC", "$type": "color", "$description": "Surface background" },
        "50":  { "$value": "#FBFAF9", "$type": "color", "$description": "Warm off-white page background" },
        "0":   { "$value": "#FFFFFF", "$type": "color", "$description": "Pure white card surface and navbar" }
      },
      "status": {
        "success":        { "$value": "#10B981", "$type": "color" },
        "success-bg":     { "$value": "#ECFDF5", "$type": "color" },
        "success-border": { "$value": "#A7F3D0", "$type": "color" },
        "success-text":   { "$value": "#065F46", "$type": "color" },
        "warning":        { "$value": "#F59E0B", "$type": "color" },
        "warning-bg":     { "$value": "#FFFBEB", "$type": "color" },
        "warning-border": { "$value": "#FDE68A", "$type": "color" },
        "warning-text":   { "$value": "#92400E", "$type": "color" },
        "error":          { "$value": "#EF4444", "$type": "color" },
        "error-bg":       { "$value": "#FEF2F2", "$type": "color" },
        "error-border":   { "$value": "#FECACA", "$type": "color" },
        "error-text":     { "$value": "#991B1B", "$type": "color" },
        "info":           { "$value": "#1F3B87", "$type": "color" },
        "info-bg":        { "$value": "#EFF6FF", "$type": "color" },
        "info-border":    { "$value": "#BFDBFE", "$type": "color" },
        "info-text":      { "$value": "#1F3B87", "$type": "color" }
      }
    },
    "typography": {
      "font-family": {
        "brand":   { "$value": "'Urbanist', 'Lexend', system-ui, -apple-system, sans-serif", "$type": "fontFamily" },
        "heading": { "$value": "'Lexend', 'Urbanist', system-ui, -apple-system, sans-serif", "$type": "fontFamily" },
        "body":    { "$value": "'Urbanist', 'Lexend', system-ui, -apple-system, sans-serif", "$type": "fontFamily" },
        "mono":    { "$value": "'JetBrains Mono', 'Fira Code', 'SF Mono', monospace", "$type": "fontFamily" }
      },
      "scale": {
        "display":  { "$value": { "fontSize": "clamp(2.5rem, 5vw, 4rem)", "fontWeight": 700, "lineHeight": 1.15, "letterSpacing": "-0.02em", "fontFamily": "{kulli.typography.font-family.heading}" }, "$type": "typography" },
        "h1":       { "$value": { "fontSize": "2.25rem", "fontWeight": 700, "lineHeight": 1.2, "letterSpacing": "-0.015em", "fontFamily": "{kulli.typography.font-family.heading}" }, "$type": "typography" },
        "h2":       { "$value": { "fontSize": "1.75rem", "fontWeight": 600, "lineHeight": 1.25, "letterSpacing": "-0.01em", "fontFamily": "{kulli.typography.font-family.heading}" }, "$type": "typography" },
        "h3":       { "$value": { "fontSize": "1.375rem", "fontWeight": 600, "lineHeight": 1.3, "letterSpacing": "-0.005em", "fontFamily": "{kulli.typography.font-family.heading}" }, "$type": "typography" },
        "h4":       { "$value": { "fontSize": "1.125rem", "fontWeight": 600, "lineHeight": 1.35, "fontFamily": "{kulli.typography.font-family.heading}" }, "$type": "typography" },
        "body-lg":  { "$value": { "fontSize": "1.125rem", "fontWeight": 400, "lineHeight": 1.6, "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "body":     { "$value": { "fontSize": "1rem", "fontWeight": 400, "lineHeight": 1.5, "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "body-sm":  { "$value": { "fontSize": "0.875rem", "fontWeight": 400, "lineHeight": 1.45, "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "label":    { "$value": { "fontSize": "0.875rem", "fontWeight": 600, "lineHeight": 1, "letterSpacing": "0.01em", "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" },
        "brand-name": { "$value": { "fontSize": "1.25rem", "fontWeight": 800, "lineHeight": 1.2, "letterSpacing": "0.25em", "textTransform": "uppercase", "fontFamily": "{kulli.typography.font-family.brand}" }, "$type": "typography" },
        "caption":  { "$value": { "fontSize": "0.75rem", "fontWeight": 500, "lineHeight": 1.35, "fontFamily": "{kulli.typography.font-family.body}" }, "$type": "typography" }
      }
    },
    "spacing": {
      "0":   { "$value": "0px", "$type": "dimension" },
      "half":{ "$value": "8px", "$type": "dimension", "$description": "halfunit" },
      "unit":{ "$value": "16px", "$type": "dimension", "$description": "unit" },
      "1andhalf": { "$value": "24px", "$type": "dimension", "$description": "oneandhalfunits" },
      "2":   { "$value": "32px", "$type": "dimension", "$description": "twounits" },
      "3":   { "$value": "48px", "$type": "dimension", "$description": "threeunits" },
      "4":   { "$value": "64px", "$type": "dimension", "$description": "fourunits" },
      "5":   { "$value": "80px", "$type": "dimension", "$description": "fiveunits" },
      "6":   { "$value": "96px", "$type": "dimension", "$description": "sixunits" },
      "8":   { "$value": "128px", "$type": "dimension", "$description": "eightunits" }
    },
    "radius": {
      "none": { "$value": "0px", "$type": "dimension" },
      "radius2": { "$value": "2px", "$type": "dimension" },
      "radius4": { "$value": "4px", "$type": "dimension" },
      "card": { "$value": "8px", "$type": "dimension", "$description": "cardradius" },
      "image":{ "$value": "8px", "$type": "dimension", "$description": "imageradius" },
      "radius16": { "$value": "16px", "$type": "dimension" },
      "button": { "$value": "24px", "$type": "dimension", "$description": "buttonradius / pill" },
      "input":  { "$value": "24px", "$type": "dimension", "$description": "inputradius" },
      "full":   { "$value": "9999px", "$type": "dimension" }
    },
    "shadow": {
      "low":    { "$value": "0 1px 3px 0 rgb(0 0 0 / 0.05), 0 1px 2px -1px rgb(0 0 0 / 0.05)", "$type": "shadow" },
      "medium": { "$value": "0 4px 6px -1px rgb(0 0 0 / 0.05), 0 2px 4px -2px rgb(0 0 0 / 0.05)", "$type": "shadow" },
      "card":   { "$value": "0 2px 8px 0 rgb(31 59 135 / 0.06)", "$type": "shadow" },
      "panel":  { "$value": "0 10px 15px -3px rgb(0 0 0 / 0.04), 0 4px 6px -4px rgb(0 0 0 / 0.04)", "$type": "shadow" }
    },
    "layout": {
      "max-width": { "$value": "1144px", "$type": "dimension", "$description": "Content max-width preserved from original design" }
    }
  }
}
