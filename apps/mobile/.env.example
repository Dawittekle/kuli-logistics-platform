# ==============================================================================
# KULI Mobile Applications Configuration Template
# (Shared by Customer App and Driver/Owner App)
# ==============================================================================

# Target App Variant: 'customer' (for cargo/moving bookings) or 'driver' (for truck owners)
KULI_APP_VARIANT=customer

# API base URL reachable from the device running Expo.
# Android emulator usually uses http://10.0.2.2:4000/api/v1 instead of localhost.
# Physical devices require your machine's LAN IP, e.g. http://192.168.1.150:4000/api/v1.
MOBILE_APP_API_BASE_URL=http://localhost:4000/api/v1

# Supabase project URL from Project Settings > API.
MOBILE_APP_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (`sb_publishable_...`) from Settings > API Keys.
# This is bundled into the mobile app; never put `sb_secret_...` here.
MOBILE_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Google Maps SDK / Javascript API Key.
# Restricted by Android Package (com.kuli.customer / com.kuli.driver) and iOS Bundle ID.
MOBILE_APP_GOOGLE_MAPS_API_KEY=AIzaSy_your_mobile_restricted_key

# Deep links configured in Supabase Auth redirect URLs and Expo scheme.
# For customer app: kuli://auth/callback
# For driver app: kuli-driver://auth/callback
MOBILE_APP_AUTH_REDIRECT_URL=kuli://auth/callback
MOBILE_APP_PASSWORD_RESET_REDIRECT_URL=kuli://auth/reset-password

# Local-only bypass for Supabase Auth. Keep false for staging/production.
MOBILE_APP_DEMO_AUTH_ENABLED=false
