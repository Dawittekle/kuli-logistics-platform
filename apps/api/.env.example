# ==============================================================================
# KULI REST API Configuration Template
# ==============================================================================

# HTTP server. Use 0.0.0.0 only when another device/emulator must reach the API.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# ------------------------------------------------------------------------------
# Supabase Authentication
# ------------------------------------------------------------------------------
# Supabase project URL from Project Settings > API. Do not include a trailing slash.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (`sb_publishable_...`) from Settings > API Keys.
# This replaces the legacy anon key and is safe for public clients when RLS is enabled.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Use `supabase` outside demo mode so API bearer tokens are verified against Supabase Auth.
SUPABASE_JWT_MODE=supabase

# Defaults for Supabase Auth JWT validation. Keep these aligned with SUPABASE_URL.
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Set true only for local demos that use `dev:<supabaseUserId>` tokens.
DEMO_AUTH_ENABLED=false

# ------------------------------------------------------------------------------
# Primary Database (PostgreSQL / Supabase Database)
# ------------------------------------------------------------------------------
# PostgreSQL connection string for local dev (Docker on 5432) or Supabase pooler in production.
DATABASE_URL=postgresql://kuli:kuli_secret@localhost:5432/kuli_db
POSTGRES_USER=kuli
POSTGRES_PASSWORD=kuli_secret
POSTGRES_DB=kuli_db
POSTGRES_PORT=5432

# Legacy MongoDB connection string (active during phased migration).
# Docker Compose exposes MongoDB on 27018.
MONGODB_URI=mongodb://localhost:27018/kuli
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# Object Storage (Cloudflare R2)
# ------------------------------------------------------------------------------
# S3-compatible private storage for vehicle documents, licenses, and delivery evidence.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=kuli-storage
R2_PUBLIC_URL=https://storage.kuli.et

# ------------------------------------------------------------------------------
# Google Maps Platform (Server-Side)
# ------------------------------------------------------------------------------
# Restricted to Routes API, Places API, and Geocoding API from authorized server IP addresses.
GOOGLE_MAPS_SERVER_API_KEY=AIzaSy_your_server_restricted_key

# ------------------------------------------------------------------------------
# SMS & Telecommunications Provider
# ------------------------------------------------------------------------------
# Provider used for phone OTP delivery in Ethiopia ('supabase', 'twilio', 'infobip', 'ethio_telecom').
SMS_PROVIDER=supabase

# ------------------------------------------------------------------------------
# Redis Cache & Queues
# ------------------------------------------------------------------------------
# Reserved for rate limiting, cache, and upcoming job queues. Docker Compose exposes Redis on 6380.
REDIS_URL=redis://localhost:6380

# ------------------------------------------------------------------------------
# CORS & Network Security
# ------------------------------------------------------------------------------
# Comma-separated browser/mobile origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

# Allows local private-network preflight requests. Set false in production.
CORS_ALLOW_PRIVATE_NETWORK=true

# ------------------------------------------------------------------------------
# Staff Initial Bootstrap
# ------------------------------------------------------------------------------
# Optional first admin profile to create/sync after the matching Supabase user exists.
BOOTSTRAP_ADMIN_SUPABASE_USER_ID=admin-seed-001
BOOTSTRAP_ADMIN_EMAIL=admin@kuli.local
BOOTSTRAP_ADMIN_FULL_NAME=Seed Admin
