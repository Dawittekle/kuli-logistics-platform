# HTTP server. Use 0.0.0.0 only when another device/emulator must reach the API.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# Supabase project URL from Project Settings > API. Do not include a trailing slash.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (`sb_publishable_...`) from Settings > API Keys.
# This replaces the legacy anon key and is safe for public clients when RLS is enabled.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Use `supabase` outside demo mode so API bearer tokens are verified against Supabase Auth.
SUPABASE_JWT_MODE=supabase

# Defaults for Supabase Auth JWT validation. Keep these aligned with SUPABASE_URL.
SUPABASE_JWT_ISSUER=https://your-project-ref.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Set true only for local demos that use `dev:<supabaseUserId>` tokens.
DEMO_AUTH_ENABLED=false

# MongoDB connection string. The included Docker Compose file exposes MongoDB on 27018.
MONGODB_URI=mongodb://localhost:27018/kuli
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Reserved for future queues/cache. The included Docker Compose file exposes Redis on 6380.
REDIS_URL=redis://localhost:6380

# Comma-separated browser/mobile origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

# Allows local private-network preflight requests. Set false in production.
CORS_ALLOW_PRIVATE_NETWORK=true

# Optional first admin profile to create/sync in MongoDB after the matching Supabase user exists.
BOOTSTRAP_ADMIN_SUPABASE_USER_ID=admin-seed-001
BOOTSTRAP_ADMIN_EMAIL=admin@kuli.local
BOOTSTRAP_ADMIN_FULL_NAME=Seed Admin
