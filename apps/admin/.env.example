# ==============================================================================
# KULI Admin Operations Console Configuration Template
# ==============================================================================

# API base URL for admin operations.
ADMIN_APP_API_BASE_URL=http://localhost:4000/api/v1

# Supabase Auth client configuration.
ADMIN_APP_SUPABASE_URL=https://your-project-ref.supabase.co
ADMIN_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Google Maps JavaScript API key for interactive operations maps.
# Restricted by HTTP referrer (e.g. https://admin.kuli.et/*).
ADMIN_APP_GOOGLE_MAPS_API_KEY=AIzaSy_your_browser_restricted_key

# Local-only bypass for Supabase Auth.
ADMIN_APP_DEMO_AUTH_ENABLED=false
