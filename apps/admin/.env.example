# API base URL used by the Vite admin dashboard.
ADMIN_APP_API_BASE_URL=http://localhost:4000/api/v1

# Supabase project URL from Project Settings > API.
ADMIN_APP_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (`sb_publishable_...`) from Settings > API Keys.
# This is exposed to browser code; never put `sb_secret_...` here.
ADMIN_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Local-only bypass for Supabase Auth. Keep false for staging/production.
ADMIN_APP_DEMO_AUTH_ENABLED=false
